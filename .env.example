# Copie para .env, na raiz (que não vai para o git). Lido pelo Supabase local ao iniciar.
# Como criar as credenciais: docs/operacao/google-oauth.md.
# Opcional para os testes: sem estes valores, só o login com Google deixa de funcionar.

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
