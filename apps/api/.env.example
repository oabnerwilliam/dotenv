# Copie para apps/api/.env (que não vai para o git).

# Banco de desenvolvimento: credencial padrão do Supabase local, não é segredo.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Endereço do front: a única origem liberada no CORS.
WEB_ORIGIN=http://localhost:5173

# Supabase Auth local. Use 127.0.0.1, não localhost: o emissor do token é comparado texto a texto.
SUPABASE_URL=http://127.0.0.1:54321

# Chave secreta (SECRET_KEY em `pnpm exec supabase status -o env`). Tem poder administrativo
# sobre o Auth: fica só no apps/api/.env, nunca no git nem no front.
SUPABASE_SECRET_KEY=

# E-mail do Google da única conta que pode criar a primeira equipe.
OWNER_EMAIL=

# Opcional: porta da API (padrão 3333).
PORT=3333

# Opcional: requisições por minuto aceitas de um mesmo IP, somando todas as rotas (padrão 300).
RATE_LIMIT_PER_MINUTE=300

# Só para testes automatizados: `true` aceita login por e-mail e senha, e a API se recusa a subir
# com ele se NODE_ENV não for `test`. Deixe `false`.
AUTH_TEST_MODE=false

# Opcional: banco dos testes (o nome precisa terminar em _test). Para trocar o padrão,
# defina no terminal; o script e os testes usam este valor:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/env_test
