# Endereço da API. Variáveis VITE_* vão para o navegador: nunca coloque segredo aqui.
VITE_API_URL=http://localhost:3333

# Supabase local, usado pelo navegador só para o login.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Só a chave publicável (PUBLISHABLE_KEY em `pnpm exec supabase status -o env`), nunca a secreta.
VITE_SUPABASE_PUBLISHABLE_KEY=